    {
      "case_id": "dsp-d03-01",
      "conjunto": "desempate",
      "family": "D03-ameaca-hipotetica",
      "meu_gabarito": "rastrear",
      "anotador": "cancelar",
      "jev": "rastrear",
      "anotador_marcou_ambigua": true,
      "text": "Se nao chegar ate sexta eu cancelo tudo. Por ora, me diz onde esta a encomenda."
