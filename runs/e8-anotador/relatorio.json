      "jev": "informacao",
      "anotador_marcou_ambigua": false,
      "text": "Não quero cancelar nada, só queria entender por que o valor mudou."
    },
    {
      "case_id": "tri-f07-04",
      "conjunto": "piloto",
      "family": "F07-cobranca-vs-cancelamento",
      "meu_gabarito": "informacao",
