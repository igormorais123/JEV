 "detalhe": [
  {
   "rodada": "R8",
   "condicao": "A-adiado",
   "case_id": "arm-A00",
   "alvo": "informacao",
   "texto": "Antes de eu pedir o estorno, me confirma se o prazo ja venceu.",
   "escolha": "informacao",
   "confianca": 0.88,
   "erro": null
  },
  {
   "rodada": "R8",
   "condicao": "A-adiado",
   "case_id": "arm-A01",
   "alvo": "informacao",
   "texto": "Vou cancelar sim, mas so depois que voces responderem sobre a multa.",
   "escolha": "informacao",
   "confianca": 0.22,
   "erro": null
  },
  {
   "rodada": "R8",
   "condicao": "A-adiado",
   "case_id": "arm-A02",
   "alvo": "informacao",
   "texto": "Me diga o valor primeiro; dependendo dele eu peco a troca.",
   "escolha": "informacao",
   "confianca": 0.89,
   "erro": null
  },
  {
   "rodada": "R8",
   "condicao": "A-adiado",
   "case_id": "arm-A03",
   "alvo": "informacao",
   "texto": "Assim que eu receber a resposta, mando o pedido de segunda via.",
   "escolha": "informacao",
   "confianca": 0.56,
   "erro": null
  },
  {
   "rodada": "R8",
   "condicao": "A-adiado",
   "case_id": "arm-A04",
   "alvo": "informacao",
   "texto": "Estou juntando os documentos para depois solicitar o reembolso.",
   "escolha": "informacao",
   "confianca": 0.49,
   "erro": null
  },
  {
   "rodada": "R8",
   "condicao": "A-adiado",
   "case_id": "arm-A05",
   "alvo": "informacao",
   "texto": "Pretendo encerrar o contrato no fim do ano. Hoje so quero entender as regras.",
   "escolha": "informacao",
   "confianca": 0.99,
   "erro": null
  },
  {
   "rodada": "R8",
   "condicao": "A-adiado",
   "case_id": "arm-A06",
   "alvo": "informacao",
   "texto": "Antes de rastrear, preciso saber se o pedido chegou a ser postado.",
   "escolha": "informacao",
   "confianca": 0.76,
   "erro": null
  },
  {
   "rodada": "R8",
   "condicao": "A-adiado",
   "case_id": "arm-A07",
   "alvo": "informacao",
   "texto": "Quando chegar a fatura eu peco o parcelamento. Por ora, so uma duvida.",
   "escolha": "informacao",
   "confianca": 0.94,
   "erro": null
  },
  {
   "rodada": "R8",
   "condicao": "B-concluida",
   "case_id": "arm-B08",
   "alvo": "informacao",
   "texto": "Ja cancelei pelo aplicativo e deu certo. Preciso fazer mais alguma coisa?",
   "escolha": "informacao",
   "confianca": 0.99,
   "erro": null
  },
  {
   "rodada": "R8",
   "condicao": "B-concluida",
   "case_id": "arm-B09",
   "alvo": "informacao",
   "texto": "A troca ja foi feita semana passada. So confirmando que esta tudo certo.",
   "escolha": "informacao",
   "confianca": 0.97,
   "erro": null
  },
  {
   "rodada": "R8",
   "condicao": "B-concluida",
   "case_id": "arm-B10",
   "alvo": "informacao",
   "texto": "Paguei o boleto ontem. Queria saber se ja consta no sistema.",
   "escolha": "informacao",
   "confianca": 0.72,
   "erro": null
  },
  {
   "rodada": "R8",
   "condicao": "B-concluida",
   "case_id": "arm-B11",
   "alvo": "informacao",
   "texto": "O produto ja chegou. Obrigado, era so isso.",
   "escolha": "informacao",
   "confianca": 0.95,
   "erro": null
  },
  {
   "rodada": "R8",
   "condicao": "B-concluida",
   "case_id": "arm-B12",
   "alvo": "informacao",
   "texto": "Consegui o estorno pelo banco. Isso gera algum problema com voces?",
   "escolha": "informacao",
   "confianca": 0.96,
   "erro": null
  },
  {
   "rodada": "R8",
   "condicao": "B-concluida",
   "case_id": "arm-B13",
   "alvo": "informacao",
   "texto": "Ja atualizei meu endereco no site. Precisa confirmar por aqui tambem?",
   "escolha": "informacao",
   "confianca": 0.98,
   "erro": null
